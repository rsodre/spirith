# One profile per deploy. Nothing but the chain config module reads these.

# Chain
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Mainnet fork test only (Phase 3). Leave empty to skip the fork suite.
MAINNET_RPC_URL=

# Deployer / keeper. Needs Sepolia ETH for gas and MockUSDC (mint it yourself).
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# The Graph. Deploy key from the subgraph's page in Subgraph Studio; the query URL is printed by
# `pnpm --filter @spirith/subgraph deploy:studio` (https://api.studio.thegraph.com/query/<id>/spirith-sepolia/<version>).
# GRAPH_API_KEY is only needed for a gateway URL, not for the Studio one.
GRAPH_DEPLOY_KEY=
SUBGRAPH_QUERY_URL=
GRAPH_API_KEY=

# Web (Phase 6)
NEXT_PUBLIC_CHAIN=sepolia
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
