# One profile per deploy. Nothing but the chain config module reads these.

# Chain
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Mainnet fork test only (Phase 3). Leave empty to skip the fork suite.
MAINNET_RPC_URL=

# Deployer / keeper. Needs Sepolia ETH for gas and MockUSDC (mint it yourself). The keeper
# key renews names it does not own; leave it empty and the keeper only simulates.
DEPLOYER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# The Graph. Deploy key from the subgraph's page in Subgraph Studio. The query URL is not a
# secret: each environment's Studio URL is derived from packages/core/deployments/subgraph.json.
# Set SUBGRAPH_QUERY_URL only to override it, e.g. with a gateway URL, which then needs
# GRAPH_API_KEY.
GRAPH_DEPLOY_KEY=
SUBGRAPH_QUERY_URL=
GRAPH_API_KEY=

# Environment: `hackathon` (ENS's dedicated ETHOnline 2026 set on Sepolia, served by its own app
# and explorer; the default) or `sepolia` (the standing ENSv2 beta, whose registrar has the older
# renew signature; contracts there are frozen at the 2026-09-09 vault). SPIRITH_ENV drives the
# forge scripts, the agent and the subgraph build; NEXT_PUBLIC_ENV the dashboard. Keep the two
# equal.
SPIRITH_ENV=hackathon

# Web (Phase 6). The browser RPC defaults to the public Sepolia node when NEXT_PUBLIC_RPC_URL is
# empty; without a WalletConnect project id only injected wallets connect.
NEXT_PUBLIC_ENV=hackathon
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
