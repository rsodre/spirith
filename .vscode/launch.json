{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "web: debug in Chrome",
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}/packages/web",
      "runtimeArgs": ["--profile-directory=Default"],
      // Sources are served from the workspace, so map the Vite dev server's URLs back onto
      // the files on disk — including `core` and `ui`, which web compiles from source.
      "sourceMapPathOverrides": {
        "/@fs/*": "/*",
        "/src/*": "${workspaceFolder}/packages/web/src/*"
      }
    }
  ]
}
